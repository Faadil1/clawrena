# Browser-visible frontend configuration (never put secrets behind VITE_)
VITE_CONVEX_URL=https://<deployment>.convex.cloud

# Build/CI only. Secret. Do NOT expose as VITE_*.
CONVEX_DEPLOY_KEY=

# Runtime-proof capture helpers (public URLs; local shell only)
PUBLIC_URL=https://<project>.pages.dev
CONVEX_HTTP_URL=https://<deployment>.convex.site
DEPLOYED_COMMIT_SHA=

# Backend secrets belong in the Convex deployment environment, not the frontend.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
JUPITER_API_KEY=
CLAWPUMP_API_KEY=
